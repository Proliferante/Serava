# --- Node / Next -----------------------------------------------------------
node_modules/
.next/
dist/
.cache/

# --- Secretos --------------------------------------------------------------
# Nunca se suben: DATABASE_URL, JWT_SECRET y las llaves viven aquí.
# `backend/.env.example` sí está en el repo, como plantilla.
.env
# Cualquier variante (.env.local, .env.destino, .env.pgi…) lleva secretos
# dentro. Se ignoran todas y se salvan a mano las plantillas, que es al revés
# de como estaba: antes había que acordarse de añadir cada archivo nuevo.
.env.*
!.env.example
!.env.destino.ejemplo

# Salida de scripts/crear_usuarios.py: contraseñas temporales en claro.
# Se reparten y se borra el archivo.
claves-temporales*.txt

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Bases SQLite de corridas antiguas del pipeline (hoy es Postgres, pero un
# `python script_extract_serava.py` viejo podría dejar una suelta).
*.db

# Pantallazos de verificación (locales, no son del proyecto)
.shots/
