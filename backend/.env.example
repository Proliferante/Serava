# Copia este archivo a backend/.env y complétalo. `.env` está en .gitignore:
# nunca se sube. Ninguna de estas claves debe acabar en un commit.

# --- base de datos ---------------------------------------------------------
# Cadena de conexión de Supabase (proyecto "Project PGI"). Está en el panel
# de Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://usuario:password@host:puerto/postgres

# --- sesiones --------------------------------------------------------------
# No hay ningún secreto que configurar: la sesión es un identificador al azar
# con su estado en la tabla `sesiones`, no un token firmado. Si vienes de una
# versión anterior, JWT_SECRET y JWT_HORAS ya no se leen y se pueden borrar.
#
# Duración de la sesión en horas (por defecto 12, una jornada).
SESION_HORAS=12

# --- CORS ------------------------------------------------------------------
# Dominios que pueden llamar a la API, separados por comas. En desarrollo el
# valor por defecto ya cubre el frontend en localhost:3000. Al desplegar:
#   CORS_ORIGINS=https://panel.zequara.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- scraping --------------------------------------------------------------
# Llave de la API de Metrocuadrado. ESTUVO ESCRITA EN EL CÓDIGO Y EN EL
# HISTORIAL DE GIT: hay que pedirle a Metrocuadrado una nueva y poner aquí
# la nueva, no la que estaba en script_extract_serava.py.
METROCUADRADO_API_KEY=

# Documentacion interactiva (/docs, /redoc, /openapi.json).
# En local, 1. Desplegado, se deja fuera: publica el mapa completo
# de la API a cualquiera que pase por ahi.
DOCS_ABIERTAS=1
