
# Firma hacia el backend (ver lib/firma.ts). Sin NEXT_PUBLIC_: nunca debe
# llegar al navegador. Vacío en local.
PROXY_SECRETO=

# Subdominio de la consola (ver middleware.ts). Vacío = la consola sigue en
# /admin. En producción: ADMIN_HOST=admin.zequara.com. Para probarlo en local:
# ADMIN_HOST=admin.localhost y abrir http://admin.localhost:3000
ADMIN_HOST=
